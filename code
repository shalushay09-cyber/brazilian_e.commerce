SELECT seller_city, COUNT (*) AS "Количество значений", ROUND(AVG(price)::numeric) AS "Средний чек", ROUND(AVG(review_score), 2) AS "Средняя оценка"
FROM "full" GROUP BY seller_city ORDER BY "Средняя оценка" DESC;

